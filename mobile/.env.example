EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Optional: public web URL used in share links (e.g. after deploying the web build)
EXPO_PUBLIC_WEB_URL=
# Optional: EAS project id (needed for push notifications on real devices)
EXPO_PUBLIC_EAS_PROJECT_ID=
# Reserved for future native Google Sign-In (v1 uses the browser flow via Supabase)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Build-time only (development/production builds on Android)
GOOGLE_MAPS_ANDROID_API_KEY=

# Optional: crash reporting (Sentry). Leave empty to disable.
EXPO_PUBLIC_SENTRY_DSN=
# development | preview | production (tags Sentry events)
EXPO_PUBLIC_APP_ENV=development
# Build-time only (EAS): SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN (secret) enable source-map upload.
# After `eas init`, paste the project id and owner into app.config.ts (EAS can't read them from env).
