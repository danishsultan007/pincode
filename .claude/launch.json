{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mohalla",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "serve.ps1"],
      "port": 8080,
      "autoPort": true
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:Path = [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User'); Set-Location mobile; npx.cmd expo start --web --port 8081"],
      "port": 8081
    }
  ]
}
